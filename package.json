{
  "name": "gamestock",
  "version": "1.0.0",
  "description": "Desktop game collection manager for ROM libraries and physical inventory.",
  "author": {
    "name": "Alex Ishida",
    "email": "alexishida@gmail.com"
  },
  "main": "dist/main/bootstrap.js",
  "type": "commonjs",
  "scripts": {
    "sync:build-meta": "node scripts/write-build-meta.cjs",
    "package:s3-release": "node scripts/package-s3-release.cjs",
    "predev": "npm run sync:build-meta",
    "dev": "concurrently -k --success first -n VITE,TSC,ELECTRON \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json -w\" \"node scripts/dev-electron.cjs\"",
    "predev:windows": "npm run sync:build-meta",
    "dev:windows": "concurrently -k --success first -n VITE,TSC,ELECTRON \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json -w\" \"node scripts/dev-electron.cjs\"",
    "prebuild:renderer": "npm run sync:build-meta",
    "build:renderer": "vite build",
    "prebuild:main": "npm run sync:build-meta",
    "build:main": "tsc -p tsconfig.main.json",
    "dist:windows": "node scripts/build-distribution.cjs --win --package-s3",
    "dist:linux": "node scripts/build-distribution.cjs --linux",
    "test:rom-folder-import": "node scripts/run-electron.cjs scripts/test-rom-folder-import.cjs",
    "test:launchbox:e2e": "node scripts/run-electron.cjs scripts/e2e-launchbox.cjs",
    "test:launchbox:e2e:packaged": "node scripts/test-packaged-launchbox.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-window": "^1.8.11",
    "sharp": "^0.34.5",
    "xml2js": "^0.6.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-window": "^1.8.8",
    "@types/sharp": "^0.31.1",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  }
}
